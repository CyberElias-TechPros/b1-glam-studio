# ==============================================================================
# B1touch Artistry / B1 Glam Studio Environment Configuration
# Target Architecture: Vercel (Frontend) + Cloudflare Ecosystem (Backend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ------------------------------------------------------------------------------
# URL of your deployed Cloudflare Worker API (e.g. https://api.b1touchartistry.com or https://b1-glam-studio-api.workers.dev)
# If empty or left unset in development, the frontend will proxy /api or use robust offline fallback.
VITE_API_URL=https://b1-glam-studio-api.workers.dev

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES & SECRETS (Cloudflare Workers / Wrangler)
# ------------------------------------------------------------------------------
# Set via: wrangler secret put JWT_SECRET
JWT_SECRET=replace_with_a_secure_random_64_character_jwt_secret_key

# Environment identifier (production | staging | development)
ENVIRONMENT=production

# Allowed Frontend URL for CORS policy
FRONTEND_URL=https://b1-glam-studio.vercel.app

# Studio WhatsApp Number (international format without + or spaces)
STUDIO_WHATSAPP=2348061651126

# Studio Support Email Address
STUDIO_EMAIL=info@b1touchartistry.com

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE RESOURCE BINDINGS (wrangler.toml)
# ------------------------------------------------------------------------------
# D1 Database: DB (b1_glam_db)
# R2 Storage Bucket: MEDIA_BUCKET (b1-glam-media)
# KV Cache Namespace: CACHE_KV (b1_glam_cache_kv)
